rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Yordamchi funksiyalar ─────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isTeacher() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    function isStudent() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student';
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ─── users collection ──────────────────────────────────────────────
    // O'qish: o'zi yoki admin
    // Yozish: o'zi (profil yangilash) yoki admin
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isTeacher();
      allow create: if isAuthenticated(); // Register paytida
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── courses collection ────────────────────────────────────────────
    // O'qish: barcha login qilgan foydalanuvchilar
    // Yozish: admin yoki o'sha kursning teacherId'siga ega teacher
    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || (isTeacher() && request.resource.data.teacherId == request.auth.uid);
      allow update: if isAdmin() ||
        (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ─── rooms collection ──────────────────────────────────────────────
    // O'qish: barcha login qilganlar
    // Yozish: faqat admin
    match /rooms/{roomId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── enrollments collection ────────────────────────────────────────
    // Student: faqat o'zinikini ko'radi va yaratadi
    // Teacher: faqat o'z kursi bo'yichalarini ko'radi
    // Admin: hammasini ko'radi va boshqaradi
    match /enrollments/{enrollmentId} {
      allow read: if isAdmin() ||
        (isStudent() && resource.data.studentId == request.auth.uid) ||
        (isTeacher() && get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.teacherId == request.auth.uid);

      allow create: if isStudent() && request.resource.data.studentId == request.auth.uid;
      allow update: if isAdmin() ||
        (isTeacher() && get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.teacherId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ─── notifications collection ──────────────────────────────────────
    // O'qish: admin va teacher
    // Yozish: admin va teacher (bildirishnoma yuborish)
    match /notifications/{notificationId} {
      allow read: if isAdmin() || isTeacher();
      allow write: if isAdmin() || isTeacher();
    }

    // ─── userNotifications collection ─────────────────────────────────
    // O'qish: faqat o'zi
    // Yozish: admin (server tomonidan) va Cloud Functions
    match /userNotifications/{notifId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAdmin();
      allow update: if isOwner(resource.data.userId); // read=true qilish uchun
      allow delete: if isAdmin() || isOwner(resource.data.userId);
    }
  }
}
